# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sia_db
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql

# JWT
# IMPORTANTE: genera claves aleatorias, ej: openssl rand -base64 48
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_32_chars
# Secreto separado para enlaces de recuperación de contraseña (defensa en profundidad).
JWT_RESET_SECRET=cambia_esta_clave_reset_por_una_aleatoria_distinta
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
# HOST=0.0.0.0 es el valor por defecto (escucha en todas las interfaces
# de red, no solo en localhost). No hace falta declararlo salvo que
# quieras forzar otro valor.
# HOST=0.0.0.0

# CORS_ORIGIN: déjalo vacío para permitir acceso desde cualquier
# dispositivo (celular, otra PC de la red, etc). Si quieres restringirlo,
# pon uno o varios orígenes separados por coma, ej:
# CORS_ORIGIN=http://localhost:3000,http://192.168.1.10:3000
CORS_ORIGIN=

# Rate-limit de login por IP (opcional, con valores por defecto razonables).
# RATE_LIMIT_LOGIN_WINDOW_MIN = minutos de la ventana (def: 15)
# RATE_LIMIT_LOGIN_MAX        = intentos máximos por IP en la ventana (def: 20)
# RATE_LIMIT_LOGIN_WINDOW_MIN=
# RATE_LIMIT_LOGIN_MAX=

# TRUST_PROXY: ponlo en 1 SOLO si el sistema corre detrás de un
# proxy/nginx. Hace que el rate-limit por IP lea la IP real del cliente
# desde la cabecera X-Forwarded-For en vez de usar siempre la del proxy.
# TRUST_PROXY=0

# Gmail
EMAIL_USER=sia.sena.2025@gmail.com
EMAIL_PASS=contraseña_de_aplicacion_16_caracteres
SUPERADMIN_EMAIL=sia.sena.2025@gmail.com
